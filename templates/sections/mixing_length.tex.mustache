\section{The Asymptotic Mixing Length ($l_0$) as a Geometric Control Parameter}
\label{app:mixing_length_geometric_control}

In classical turbulence closures, Blackadar's asymptotic mixing length $l_0$ functions as an empirical coefficient tuned to yield realistic turbulent diffusivities. Within the 4D GSPT-SBL framework, however, $l_0$ enters the reduced dynamics analytically, governing the topology of the critical manifold $\mathcal{S}_0$.

\subsection{Mathematical Setting and Assumptions}
\label{sub:math_setting_assumptions}

\begin{assumption}[Reduced Atmospheric Subsystem]
\label{ass:reduced_sbl}
Consider the reduced atmospheric subsystem obtained from the regularized 4D GSPT-SBL equations under the classic Blackadar mixing-length closure:
\begin{equation}
    l(z) = \frac{\kappa z}{1 + \frac{\kappa z}{l_0}}
\end{equation}
with fixed physical parameters $\beta > 0$, background mixing floor $\delta > 0$, and closure constant $c_\mu > 0$. Assume the critical manifold $\mathcal{S}_0$ is defined by the reduced equilibrium relation $F(q, \Delta; l_0) = 0$, where $q$ is the velocity scale, $\Delta$ is net environmental forcing, and $e \ge 0$ is turbulent kinetic energy.
\end{assumption}

\subsection{Formal Theorems and Corollaries}
\label{sub:theorems_corollaries}

\begin{theorem}[Asymptotic Mixing Length as a Geometric Control Parameter]
\label{thm:l0_control_parameter}
Under Assumption~\ref{ass:reduced_sbl}, $l_0 \in \mathbb{R}^+$ acts as a codimension-one bifurcation parameter governing the topology of the critical manifold $\mathcal{S}_0$. Continuous variation of $l_0$:
\begin{enumerate}
    \item \textbf{Rescales Equilibrium Geometry:} Deforms the active attracting equilibrium surface through multiplicative scaling of the stable branch:
    \begin{equation}
        q_+(\Delta) = \frac{\beta l_0 + l_0 \sqrt{\beta^2 + 4\Delta}}{2}.
    \end{equation}
    \item \textbf{Shifts Fold Catastrophe Invariants:} The fold locus $\mathcal{C}_{\text{fold}}$ coordinates in the reduced model satisfy the analytical relations:
    \begin{equation}
        e_{\text{fold}}(l_0) = \frac{\beta^2 l_0^2}{4} - \delta, \qquad q_{\text{fold}}(l_0) = \frac{\beta l_0}{2}.
    \end{equation}
    \item \textbf{Parameter-Space Bifurcation Boundary:} The equality
    \begin{equation}
        \delta = \frac{\beta^2 l_0^2}{4}
    \end{equation}
    defines a codimension-one bifurcation boundary in parameter space $(\delta, l_0)$. On one side of this boundary ($\delta < \frac{\beta^2 l_0^2}{4}$), the reduced critical manifold possesses a physically admissible fold ($e_{\text{fold}} > 0$), whereas on the other side ($\delta \ge \frac{\beta^2 l_0^2}{4}$), the fold lies outside the admissible domain $e \ge 0$.
\end{enumerate}
\end{theorem}

\begin{corollary}[Monotonic Limit]
\label{cor:monotonic_limit}
If $\delta \ge \frac{\beta^2 l_0^2}{4}$, the reduced atmospheric critical manifold $\mathcal{S}_0$ possesses no physically admissible interior fold ($e_{\text{fold}} \le 0$). Consequently, catastrophic turbulence collapse through an interior fold bifurcation of the isolated atmospheric subsystem cannot occur.
\end{corollary}

\begin{theorem}[Monotonic Deformation Theorem]
\label{thm:monotonic_deformation}
Let $l_0^{(1)} < l_0^{(2)}$. The corresponding critical manifolds satisfy an order-preserving geometric deformation:
\begin{equation}
    \mathcal{S}_0\left(l_0^{(1)}\right) \prec \mathcal{S}_0\left(l_0^{(2)}\right)
\end{equation}
where increasing $l_0$ monotonically enlarges the admissible folded region in phase space while preserving manifold topology until the codimension-one boundary $\delta = \frac{\beta^2 l_0^2}{4}$ is crossed.
\end{theorem}

\begin{proof}[Proof Sketch for Theorem~\ref{thm:l0_control_parameter} and Theorem~\ref{thm:monotonic_deformation}]
Evaluating $F(q, \Delta; l_0) = 0$ along $e \ge 0$ yields $q_+(\Delta)$ as an explicit function scaled by $l_0$. Differentiating $F$ with respect to state variables gives the saddle-node condition $\partial F / \partial q = 0$, producing $q_{\text{fold}} = \beta l_0 / 2$. Substituting $q_{\text{fold}}$ back into the energy equilibrium condition yields $e_{\text{fold}}(l_0) = \beta^2 l_0^2 / 4 - \delta$. Admissibility requires $e_{\text{fold}} > 0$, yielding the parameter boundary $\delta = \beta^2 l_0^2 / 4$. Monotonicity of the spatial inclusion $\mathcal{S}_0(l_0^{(1)}) \prec \mathcal{S}_0(l_0^{(2)})$ follows directly from $\partial q_+ / \partial l_0 > 0$ for all $\Delta > -\beta^2/4$.
\end{proof}

