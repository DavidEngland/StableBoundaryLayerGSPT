\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Geometric Resolution of the Richardson Paradox.} (a) In the 5D state space $\Omega _0$, physical trajectories follow the 1D intersection curve $\gamma _{\mathrm  {site}} = \mathcal  {S}_0 \cap \Sigma _{\mathrm  {site}}$ until reaching the 2D fold locus $\mathcal  {C}_{\mathrm  {fold}}$. (b) Under observation mapping $\boldsymbol  {\Pi }_{\mathrm  {obs}}$, the single invariant fold locus projects to a 2D surface $\Gamma _{\mathrm  {fold}}$ in scalar diagnostic space $(S, Ri)$. Site-specific profiles intersect $\Gamma _{\mathrm  {fold}}$ at vastly different apparent scalar thresholds ($Ri_{\mathrm  {CASES}} \approx 0.20$ vs. $Ri_{\mathrm  {SHEBA}} \approx 0.85$).}}{12}{figure.1}\protected@file@percent }
\newlabel{fig:projection_paradox}{{1}{12}{\textbf {Geometric Resolution of the Richardson Paradox.} (a) In the 5D state space $\Omega _0$, physical trajectories follow the 1D intersection curve $\gamma _{\mathrm {site}} = \mathcal {S}_0 \cap \Sigma _{\mathrm {site}}$ until reaching the 2D fold locus $\mathcal {C}_{\mathrm {fold}}$. (b) Under observation mapping $\boldsymbol {\Pi }_{\mathrm {obs}}$, the single invariant fold locus projects to a 2D surface $\Gamma _{\mathrm {fold}}$ in scalar diagnostic space $(S, Ri)$. Site-specific profiles intersect $\Gamma _{\mathrm {fold}}$ at vastly different apparent scalar thresholds ($Ri_{\mathrm {CASES}} \approx 0.20$ vs. $Ri_{\mathrm {SHEBA}} \approx 0.85$)}{figure.1}{}}
